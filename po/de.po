msgstr "Konten ohne Benachrichtigungen"

#: data/io.github.deviablo.EMail.gschema.xml:46 crates/app/src/settings.rs:74
msgid "Language of the app"
msgstr "Sprache der App"

#: data/io.github.deviablo.EMail.gschema.xml:47
msgid "Empty to follow the system. Takes effect after a restart."
msgstr "Leer, um dem System zu folgen. Gilt nach einem Neustart."

#: data/io.github.deviablo.EMail.gschema.xml:51
msgid "Load external images without asking"
msgstr "Externe Bilder ohne Nachfrage laden"

#: data/io.github.deviablo.EMail.gschema.xml:55 crates/app/src/settings.rs:135
msgid "Group messages into conversations"
msgstr "Als Unterhaltungen gruppieren"

